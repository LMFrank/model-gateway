APP_ENV=dev
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8080
GATEWAY_PORT=8080
GATEWAY_UI_PORT=8620
GATEWAY_CONTAINER_NAME=model-gateway
GATEWAY_DOCKER_NETWORK=gateway_shared_net
DB_DOCKER_NETWORK=gateway_shared_net
OBSERVABILITY_DOCKER_NETWORK=observability_net
OBSERVABILITY_LABEL_PREFIX=observability
KIMI_HOME_DIR=./runtime/kimi-home
CODEX_HOME_DIR=./runtime/codex-home

GATEWAY_CLIENT_TOKEN=replace_with_client_token
GATEWAY_ADMIN_TOKEN=replace_with_admin_token

PG_HOST=pg
PG_PORT=5432
PG_USER=model_gateway_user
PG_PASSWORD=replace_with_password
PG_DATABASE=model_gateway
PG_CONNECT_TIMEOUT=5

QWEN_TIMEOUT_SEC=120
KIMI_TIMEOUT_SEC=120
KIMI_CLI_CMD=kimi

# 审计默认只保存调用元数据；明确需要排障内容时才临时开启 body。
AUDIT_CAPTURE_BODIES=false
AUDIT_RETENTION_DAYS=30
AUDIT_CLEANUP_INTERVAL_SEC=3600

# 0 表示关闭；设置为正数后按间隔自动检查所有启用 Provider。
PROVIDER_HEALTH_CHECK_INTERVAL_SEC=0
